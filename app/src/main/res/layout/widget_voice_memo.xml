<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/voice_widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_background">

    <ImageButton
        android:id="@+id/btn_record_voice"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_microphone_24"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Ses Kaydını Başlat"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/tv_widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kaydetmek için dokun"
        android:textColor="@android:color/black"
        android:textSize="12sp"
        android:layout_marginTop="4dp"/>

</LinearLayout>